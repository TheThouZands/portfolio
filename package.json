{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "node:use": "nvm use 25.9.0",
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run db:migrate && next build",
    "start": "next start",
    "test": "npm run test:unit",
    "test:ci": "npm run lint && npm run typecheck && npm run test",
    "test:unit": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:scss": "stylelint \"src/**/*.{css,scss}\"",
    "db:branch:sync": "node scripts/sync-neon-branch.mjs",
    "db:branch:migrate": "npm run db:branch:sync && npm run db:migrate",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node scripts/seed-demo-data.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.20",
    "@neondatabase/serverless": "^1.1.0",
    "argon2": "^0.44.0",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vercel": "^54.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "sass": "^1.98.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.12.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
